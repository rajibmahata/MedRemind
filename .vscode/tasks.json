{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Backend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/backend/MedRemind.API/MedRemind.API.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Build Frontend",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/web/MedRemind.Web/MedRemind.Web.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": "build"
        },
        {
            "label": "Run Backend API",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/backend/MedRemind.API/MedRemind.API.csproj",
                "--urls",
                "http://localhost:5000"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "none"
        },
        {
            "label": "Run Frontend UI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/web/MedRemind.Web/MedRemind.Web.csproj"
            ],
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "none"
        },
        {
            "label": "Run Both (Backend + Frontend)",
            "dependsOn": [
                "Run Backend API",
                "Run Frontend UI"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Stop All",
            "command": "echo",
            "type": "shell",
            "args": [
                "Stopping services..."
            ],
            "problemMatcher": []
        }
    ]
}
