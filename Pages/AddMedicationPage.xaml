<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MedRemind.ViewModels"
             x:Class="MedRemind.Pages.AddMedicationPage"
             x:DataType="viewmodels:AddMedicationViewModel"
             Title="Add Medication">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <Label Text="Add New Medication" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <Label Text="Medication Name *" FontSize="14" TextColor="Gray"/>
            <Entry Text="{Binding Name}" 
                   Placeholder="Enter medication name"
                   ReturnType="Next"/>

            <Label Text="Dosage" FontSize="14" TextColor="Gray"/>
            <Entry Text="{Binding Dosage}" 
                   Placeholder="e.g., 500mg"
                   ReturnType="Next"/>

            <Label Text="Frequency" FontSize="14" TextColor="Gray"/>
            <Entry Text="{Binding Frequency}" 
                   Placeholder="e.g., Twice daily"
                   ReturnType="Next"/>

            <Label Text="Instructions" FontSize="14" TextColor="Gray"/>
            <Editor Text="{Binding Instructions}" 
                    Placeholder="Special instructions..."
                    HeightRequest="100"/>

            <Label Text="Start Date" FontSize="14" TextColor="Gray"/>
            <DatePicker Date="{Binding StartDate}" 
                       Format="D"/>

            <Label Text="Notes" FontSize="14" TextColor="Gray"/>
            <Editor Text="{Binding Notes}" 
                    Placeholder="Additional notes..."
                    HeightRequest="100"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" 
                        Text="Cancel" 
                        BackgroundColor="LightGray"
                        TextColor="Black"
                        Command="{Binding CancelCommand}"/>
                <Button Grid.Column="1" 
                        Text="Save" 
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding SaveMedicationCommand}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
