<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MedRemind.ViewModels"
             x:Class="MedRemind.Pages.PrescriptionReaderPage"
             x:DataType="viewmodels:PrescriptionReaderViewModel"
             Title="Prescription Reader">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="📋 Scan Prescription" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,10,0,20"/>

            <Label Text="Take a photo or select an existing image of your prescription. Our AI will extract the medication information for you."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10"/>

            <!-- Action Buttons -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Grid.Column="0"
                        Text="📷 Take Photo"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding TakePhotoCommand}"/>
                <Button Grid.Column="1"
                        Text="🖼️ Pick Photo"
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding PickPhotoCommand}"/>
            </Grid>

            <!-- Image Preview -->
            <Frame IsVisible="{Binding HasImage}" 
                   Padding="0" 
                   CornerRadius="10"
                   HasShadow="True">
                <Grid>
                    <Image Source="{Binding ImagePath}"
                           Aspect="AspectFit"
                           HeightRequest="300"/>
                    <Button Text="✕"
                            BackgroundColor="Red"
                            TextColor="White"
                            WidthRequest="40"
                            HeightRequest="40"
                            CornerRadius="20"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="10"
                            Command="{Binding ClearImageCommand}"/>
                </Grid>
            </Frame>

            <!-- Processing Indicator -->
            <ActivityIndicator IsRunning="{Binding IsProcessing}"
                             IsVisible="{Binding IsProcessing}"
                             Color="{StaticResource Primary}"
                             HeightRequest="50"/>

            <Label Text="Processing prescription..."
                   IsVisible="{Binding IsProcessing}"
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Extracted Text -->
            <Frame IsVisible="{Binding HasImage}" 
                   Padding="15" 
                   CornerRadius="10"
                   BackgroundColor="White"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Extracted Text:" 
                           FontSize="16" 
                           FontAttributes="Bold"/>
                    <ScrollView HeightRequest="200">
                        <Label Text="{Binding ExtractedText}"
                               FontSize="14"
                               LineBreakMode="WordWrap"/>
                    </ScrollView>
                </VerticalStackLayout>
            </Frame>

            <Label IsVisible="{Binding HasImage}"
                   Text="💡 Tip: You can now manually add medications from the extracted information to your medication list."
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
