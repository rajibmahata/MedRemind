            "body": {
              "mode": "raw",
              "raw": "{\n    \"userId\": {{user_id}},\n    \"name\": \"Paracetamol\",\n    \"dosage\": \"500mg\",\n    \"frequency\": \"Twice daily\",\n    \"startDate\": \"2024-01-15T00:00:00Z\",\n    \"endDate\": \"2024-02-15T00:00:00Z\",\n    \"reminderTimes\": [\"09:00\", \"21:00\"],\n    \"notes\": \"Take after meals\"\n}"
