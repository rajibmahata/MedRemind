<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Target Android only for development -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		
		<OutputType>Exe</OutputType>
		<RootNamespace>MedRemind.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>MedRemind</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.medremind.app</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		
		<!-- FIX: Add Runtime Identifiers for Android -->
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
		
		<!-- FIX: Configure assembly linking to include satellite assemblies -->
		<AndroidLinkMode>SdkOnly</AndroidLinkMode>
		<AndroidEnableAssemblyCompression>false</AndroidEnableAssemblyCompression>
		<AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
		
		<!-- FIX: Ensure all resources are embedded -->
		<EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
		<EnableLLVM>false</EnableLLVM>
		<AndroidUseAapt2>true</AndroidUseAapt2>
		
		<!-- ALTERNATIVE FIX: Use invariant globalization (disables culture-specific resources) -->
		<!-- Uncomment if the above doesn't work -->
		<!-- <InvariantGlobalization>true</InvariantGlobalization> -->
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#4CAF50" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#4CAF50" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<AndroidResource Remove="Platforms\Android\Resources\xml\network_security_config.xml" />
		
		<!-- Embedded Configuration -->
		<embeddedResource Include="appsettings.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="10.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.1" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\backend\MedRemind.Core\MedRemind.Core.csproj" />
	  <ProjectReference Include="..\..\backend\MedRemind.Services\MedRemind.Services.csproj" />
	</ItemGroup>

	<ItemGroup>
    <!-- Android Resources -->
    <AndroidResource Include="Platforms\Android\Resources\**\*.xml" />
    <AndroidResource Include="Platforms\Android\Resources\xml\network_security_config.xml" />
  </ItemGroup>

</Project>
