<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MedRemind.Mobile.ViewModels"
             x:Class="MedRemind.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <!-- Header -->
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding GreetingMessage}"
                       Style="{StaticResource HeaderLabel}"/>
                <Label Text="Track your medication journey"
                       Style="{StaticResource CaptionLabel}"/>
            </VerticalStackLayout>

            <!-- Adherence Summary Card -->
            <Frame Style="{StaticResource CardFrame}">
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                    
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="{Binding CurrentStreak}"
                               FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"/>
                        <Label Text="Day Streak 🔥"
                               Style="{StaticResource BodyLabel}"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label FontSize="36"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Secondary}">
                            <Label.Text>
                                <Binding Path="AdherencePercentage" StringFormat="{}{0:F0}%"/>
                            </Label.Text>
                        </Label>
                        <Label Text="Adherence"
                               Style="{StaticResource BodyLabel}"/>
                    </VerticalStackLayout>

                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2"
                                Progress="{Binding AdherencePercentage, Converter={StaticResource PercentToDecimalConverter}}"
                                ProgressColor="{StaticResource Primary}"
                                Margin="0,16,0,0"/>
                </Grid>
            </Frame>

            <!-- Today's Progress -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Today's Progress"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Grid ColumnDefinitions="*,*,*">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding TodaysTotalDoses}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Gray800}"/>
                            <Label Text="Total"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="{Binding TodaysTakenDoses}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Success}"/>
                            <Label Text="Taken"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="{Binding TodaysMissedDoses}"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Error}"/>
                            <Label Text="Missed"
                                   Style="{StaticResource CaptionLabel}"/>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Actions -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Quick Actions"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="📤 Upload Prescription"
                                Command="{Binding NavigateToUploadCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="60"/>

                        <Button Grid.Column="1"
                                Text="💊 View Medications"
                                Command="{Binding NavigateToMedicationsCommand}"
                                Style="{StaticResource SecondaryButton}"
                                HeightRequest="60"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Today's Medications -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Today's Medications"
                           Style="{StaticResource SubHeaderLabel}"/>

                    <CollectionView ItemsSource="{Binding TodaysMedications}"
                                   EmptyView="No medications for today ✅">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame BackgroundColor="{StaticResource Gray100}"
                                       CornerRadius="10"
                                       Padding="12"
                                       Margin="0,4"
                                       HasShadow="False">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="{Binding Name}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Gray900}"/>
                                            <Label FontSize="14"
                                                   TextColor="{StaticResource Gray600}">
                                                <Label.Text>
                                                    <MultiBinding StringFormat="{}{0} {1} - {2}">
                                                        <Binding Path="Dosage"/>
                                                        <Binding Path="Unit"/>
                                                        <Binding Path="Frequency"/>
                                                    </MultiBinding>
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>

                                        <Button Grid.Column="1"
                                                Text="✓ Take"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=TakeDoseCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="{StaticResource Success}"
                                                TextColor="White"
                                                CornerRadius="15"
                                                Padding="16,8"
                                                FontSize="14"/>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}"
                             Color="{StaticResource Primary}"
                             HeightRequest="40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
