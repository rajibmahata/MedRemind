<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MedRemind.Mobile.ViewModels"
             x:Class="MedRemind.Mobile.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Primary}">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25" VerticalOptions="Center">
            
            <!-- Logo/Icon Section -->
            <VerticalStackLayout Spacing="15" Margin="0,0,0,30">
                <Image Source="pill_icon.png" 
                       HeightRequest="100"
                       WidthRequest="100"
                       HorizontalOptions="Center"/>
                
                <Label Text="MedRemind"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                
                <Label Text="Never miss your medication again"
                       FontSize="16"
                       TextColor="White"
                       Opacity="0.8"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Login Card -->
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HasShadow="True"
                   Padding="25">
                
                <VerticalStackLayout Spacing="20">
                    
                    <Label Text="Sign In"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"/>
                    
                    <!-- Phone Number Input -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Phone Number"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"/>
                        
                        <Frame BorderColor="{StaticResource Primary}"
                               CornerRadius="10"
                               Padding="12,8"
                               HasShadow="False">
                            <Entry Text="{Binding PhoneNumber}"
                                   Placeholder="Enter 10-digit phone number"
                                   Keyboard="Telephone"
                                   MaxLength="10"
                                   TextColor="{StaticResource Gray900}"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- OTP Input (Visible after sending OTP) -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsOtpVisible}">
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="OTP Code"
                                   FontSize="14"
                                   TextColor="{StaticResource Gray600}"
                                   VerticalOptions="Center"/>
                            
                            <Label Text="Resend"
                                   FontSize="12"
                                   TextColor="{StaticResource Primary}"
                                   TextDecorations="Underline"
                                   VerticalOptions="Center"
                                   HorizontalOptions="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResendOtpCommand}"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>
                        
                        <Frame BorderColor="{StaticResource Primary}"
                               CornerRadius="10"
                               Padding="12,8"
                               HasShadow="False">
                            <Entry Text="{Binding Otp}"
                                   Placeholder="Enter 6-digit OTP"
                                   Keyboard="Numeric"
                                   MaxLength="6"
                                   TextColor="{StaticResource Gray900}"/>
                        </Frame>
                    </VerticalStackLayout>

                    <!-- Error Message -->
                    <Frame IsVisible="{Binding HasError}"
                           BackgroundColor="#FFE5E5"
                           CornerRadius="8"
                           Padding="12"
                           HasShadow="False">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#D32F2F"
                               FontSize="12"/>
                    </Frame>

                    <!-- Login Button -->
                    <Button Text="{Binding ButtonText}"
                            Command="{Binding VerifyOtpCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            Margin="0,10,0,0"/>

                    <!-- Biometric Login Button -->
                    <Button Text="{Binding BiometricButtonText}"
                            Command="{Binding BiometricLoginCommand}"
                            BackgroundColor="Transparent"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="2"
                            CornerRadius="25"
                            HeightRequest="50"
                            FontSize="16"
                            FontAttributes="Bold"
                            IsVisible="{Binding ShowBiometricButton}"
                            Margin="0,5,0,0"/>

                    <!-- OR Divider -->
                    <Grid ColumnDefinitions="*,Auto,*" IsVisible="{Binding ShowBiometricButton}" Margin="0,5">
                        <BoxView Color="{StaticResource Gray300}" HeightRequest="1" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="OR" FontSize="12" TextColor="{StaticResource Gray600}" Margin="10,0"/>
                        <BoxView Grid.Column="2" Color="{StaticResource Gray300}" HeightRequest="1" VerticalOptions="Center"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                     IsVisible="{Binding IsBusy}"
                                     Color="{StaticResource Primary}"
                                     HeightRequest="30"/>
                    
                </VerticalStackLayout>
            </Frame>

            <!-- Privacy Note -->
            <Label Text="Your data is stored securely on your device"
                   FontSize="12"
                   TextColor="White"
                   Opacity="0.7"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
