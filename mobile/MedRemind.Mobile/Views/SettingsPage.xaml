<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MedRemind.Mobile.ViewModels"
             x:Class="MedRemind.Mobile.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            
            <Label Text="Settings"
                   Style="{StaticResource HeaderLabel}"/>

            <!-- Profile Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Profile"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                        <Label Text="??"
                              FontSize="48"
                              Grid.RowSpan="2"/>
                        
                        <Label Grid.Column="1"
                              Text="{Binding UserName}"
                              FontSize="20"
                              FontAttributes="Bold"
                              TextColor="{StaticResource Gray900}"
                              VerticalOptions="End"/>
                        
                        <Label Grid.Row="1" Grid.Column="1"
                              Text="{Binding UserPhone}"
                              FontSize="14"
                              TextColor="{StaticResource Gray600}"
                              VerticalOptions="Start"/>
                    </Grid>

                    <Button Text="Edit Profile"
                           Command="{Binding UpdateProfileCommand}"
                           Style="{StaticResource SecondaryButton}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Notifications Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Notifications"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Enable Notifications"
                              VerticalOptions="Center"
                              Style="{StaticResource BodyLabel}"/>
                        <Switch Grid.Column="1"
                               IsToggled="{Binding NotificationsEnabled}"
                               Command="{Binding ToggleNotificationsCommand}"
                               OnColor="{StaticResource Primary}"/>
                    </Grid>

                    <BoxView HeightRequest="1"
                            Color="{StaticResource Gray300}"/>

                    <Label Text="Sound: Enabled"
                          Style="{StaticResource BodyLabel}"/>
                    
                    <Label Text="Vibration: Enabled"
                          Style="{StaticResource BodyLabel}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Security Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Security"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Biometric Authentication"
                                  FontAttributes="Bold"
                                  Style="{StaticResource BodyLabel}"/>
                            <Label Text="Use fingerprint or face to unlock"
                                  FontSize="12"
                                  TextColor="{StaticResource Gray600}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                               IsToggled="{Binding BiometricEnabled}"
                               Command="{Binding ToggleBiometricCommand}"
                               OnColor="{StaticResource Primary}"
                               VerticalOptions="Center"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Appearance Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Appearance"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <Label Text="Theme"
                          Style="{StaticResource BodyLabel}"/>
                    
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Text="Light"
                               Command="{Binding ChangeThemeCommand}"
                               CommandParameter="Light"
                               BackgroundColor="{StaticResource Gray300}"
                               TextColor="{StaticResource Gray900}"
                               CornerRadius="15"/>
                        
                        <Button Grid.Column="1"
                               Text="Dark"
                               Command="{Binding ChangeThemeCommand}"
                               CommandParameter="Dark"
                               BackgroundColor="{StaticResource Gray800}"
                               TextColor="White"
                               CornerRadius="15"/>
                        
                        <Button Grid.Column="2"
                               Text="System"
                               Command="{Binding ChangeThemeCommand}"
                               CommandParameter="System"
                               BackgroundColor="{StaticResource Primary}"
                               TextColor="White"
                               CornerRadius="15"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- About Section -->
            <Frame Style="{StaticResource CardFrame}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="About"
                           Style="{StaticResource SubHeaderLabel}"/>
                    
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="Version:"
                              Style="{StaticResource BodyLabel}"/>
                        <Label Text="{Binding AppVersion}"
                              FontAttributes="Bold"
                              Style="{StaticResource BodyLabel}"/>
                    </HorizontalStackLayout>

                    <Button Text="Privacy Policy"
                           Command="{Binding ViewPrivacyPolicyCommand}"
                           Style="{StaticResource SecondaryButton}"/>
                    
                    <Button Text="Terms of Service"
                           Command="{Binding ViewTermsCommand}"
                           Style="{StaticResource SecondaryButton}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Logout Button -->
            <Button Text="Logout"
                   Command="{Binding LogoutCommand}"
                   BackgroundColor="{StaticResource Error}"
                   TextColor="White"
                   CornerRadius="25"
                   HeightRequest="50"
                   FontSize="16"
                   FontAttributes="Bold"
                   Margin="0,16,0,32"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
