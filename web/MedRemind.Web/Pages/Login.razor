@page "/login"
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Login - MedRemind</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="8" Class="pa-8" Style="border-radius: 16px;">
        
        <!-- Header -->
        <div Class="text-center mb-6">
            <div Style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); width: 80px; height: 80px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
                <MudIcon Icon="@Icons.Material.Filled.Login" Size="Size.Large" Style="color: white;" />
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 700; color: #333;">Welcome Back!</MudText>
            <MudText Typo="Typo.body2" Class="mt-2" Style="color: #666;">
                Login to manage your medications
            </MudText>
        </div>
        
        <!-- OTP Email Notice -->
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" Style="border-radius: 8px; border-left: 4px solid #2196f3;">
            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Small" Class="mr-1" />
                Pilot Version: OTP will be sent to your email
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #666;">
                We'll send a verification code to your registered email
            </MudText>
        </MudAlert>
        
        <!-- Login Form -->
        <MudForm @ref="form" @bind-IsValid="@isFormValid">
            <MudText Typo="Typo.body2" Class="mb-4" Style="color: #666; font-weight: 600;">
                Enter your phone number to login:
            </MudText>
            
            <!-- Phone Number -->
            <MudTextField @bind-Value="phoneNumber" 
                         Label="Phone Number" 
                         Variant="Variant.Outlined"
                         Required="true"
                         RequiredError="Phone number is required"
                         Validation="@(new Func<string, string>(ValidatePhoneNumber))"
                         Adornment="Adornment.Start"
                         AdornmentIcon="@Icons.Material.Filled.Phone"
                         AdornmentColor="Color.Primary"
                         Placeholder="9876543210"
                         HelperText="10-digit mobile number"
                         Mask="@(new PatternMask("0000000000"))"
                         Class="mb-4"
                         Style="border-radius: 8px;" />
                         
            <!-- Login Button -->
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      Disabled="@(!isFormValid || isLoading)"
                      OnClick="HandleLogin"
                      FullWidth="true"
                      Size="Size.Large"
                      Style="border-radius: 8px; padding: 14px; font-weight: 600;">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Sending OTP...</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Send" Class="mr-2" />
                    <span>Send OTP</span>
                }
            </MudButton>
        </MudForm>
        
        <MudDivider Class="my-6" />
        
        <!-- Don't have account -->
        <MudText Typo="Typo.body2" Align="Align.Center" Style="color: #666;">
            Don't have an account?
            <MudLink Href="/register" Typo="Typo.body2" Style="font-weight: 600; color: #667eea;">
                Register here
            </MudLink>
        </MudText>
        
        <!-- What happens next -->
        <MudPaper Elevation="0" Class="pa-4 mt-4" Style="background: #f8f9fa; border-radius: 8px;">
            <MudText Typo="Typo.body2" Class="mb-2" Style="font-weight: 600; color: #333;">
                <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" Class="mr-1" />
                What happens next?
            </MudText>
            <MudText Typo="Typo.caption" Style="color: #666; line-height: 1.6;">
                1. Check your email for the OTP verification code<br/>
                2. Enter the 6-digit code to verify and login<br/>
                3. Access your prescriptions and medications<br/>
                4. Manage your reminders and voice recordings
            </MudText>
        </MudPaper>
        
        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-4" Style="border-radius: 8px;">
            <MudText Typo="Typo.caption">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Class="mr-1" />
                Your information is secure and protected.
            </MudText>
        </MudAlert>
    </MudPaper>
</MudContainer>

@code {
    private MudForm? form;
    private bool isFormValid;
    private bool isLoading;
    
    private string phoneNumber = "";
    
    private string ValidatePhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
            return "Phone number is required";
            
        if (phone.Length != 10)
            return "Phone number must be 10 digits";
            
        if (!phone.All(char.IsDigit))
            return "Phone number must contain only digits";
            
        return null;
    }
    
    private async Task HandleLogin()
    {
        if (!isFormValid) return;
        
        isLoading = true;
        try
        {
            var success = await AuthService.SendOtpAsync(phoneNumber);
            
            if (success)
            {
                Snackbar.Add("OTP sent successfully! Please check your email inbox (and spam folder).", Severity.Success, config =>
                {
                    config.VisibleStateDuration = 5000;
                    config.Icon = Icons.Material.Filled.CheckCircle;
                });
                
                // Navigate to OTP verification page
                Navigation.NavigateTo($"/verify-otp?phone={phoneNumber}");
            }
            else
            {
                Snackbar.Add("Failed to send OTP. Please check your phone number and try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}

