@page "/medications"
@inject IAuthService AuthService
@inject IMedicationService MedicationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>My Medications - MedRemind</PageTitle>


        <MudText Typo="Typo.h4" Class="mb-6">
            <MudIcon Icon="@Icons.Material.Filled.Medication" Class="mr-2" />
            My Medications
        </MudText>
        
        @if (isLoading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
        }
        else if (medications.Any())
        {
            <MudGrid>
                @foreach (var medication in medications)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard Elevation="3" Class="pa-4 h-100">
                            <MudCardContent>
                                <MudText Typo="Typo.h6" Class="mb-3">
                                    <MudIcon Icon="@Icons.Material.Filled.LocalPharmacy" Size="Size.Small" Color="Color.Primary" Class="mr-1" />
                                    @medication.Name
                                </MudText>
                                
                                <MudChip T="string"
                                        Size="Size.Small" 
                                        Color="Color.Primary" 
                                        Icon="@Icons.Material.Filled.Science"
                                        Class="mb-3">
                                    @medication.Dosage
                                </MudChip>
                                
                                <MudDivider Class="my-3" />
                                
                                <MudStack Spacing="2">
                                    <MudText Typo="Typo.body2">
                                        <strong>Frequency:</strong> @medication.Frequency
                                    </MudText>
                                    <MudText Typo="Typo.body2">
                                        <strong>Duration:</strong> @medication.Duration
                                    </MudText>
                                    
                                    @if (medication.StartDate.HasValue)
                                    {
                                        <MudText Typo="Typo.body2">
                                            <strong>Start:</strong> @medication.StartDate.Value.ToShortDateString()
                                        </MudText>
                                    }
                                    
                                    @if (!string.IsNullOrEmpty(medication.Instructions))
                                    {
                                        <MudText Typo="Typo.caption" >
                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-1" />
                                            @medication.Instructions
                                        </MudText>
                                    }
                                </MudStack>
                                
                                <MudChip T="string"
                                        Size="Size.Small" 
                                        Color="@(medication.IsActive ? Color.Success : Color.Default)"
                                        Icon="@(medication.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Pause)"
                                        Class="mt-3">
                                    @(medication.IsActive ? "Active" : "Inactive")
                                </MudChip>
                            </MudCardContent>
                            
                            <MudCardActions>
                                <MudButton Size="Size.Small" 
                                          Color="Color.Primary" 
                                          Href="@($"/medications/{medication.Id}")"
                                          StartIcon="@Icons.Material.Filled.Visibility">
                                    View Details
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
            
            <MudText Typo="Typo.caption"  Class="mt-4">
                Total: @medications.Count medication(s)
            </MudText>
        }
        else
        {
            <MudPaper Elevation="3" Class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.MedicationLiquid" 
                        Size="Size.Large" 
                        Color="Color.Default" 
                        Class="mb-4" />
                <MudText Typo="Typo.h6" Class="mb-3">
                    No Medications Yet
                </MudText>
                <MudText Typo="Typo.body2"  Class="mb-4">
                    Upload your first prescription to get started!
                </MudText>
                <MudButton Variant="Variant.Filled" 
                          Color="Color.Primary" 
                          Href="/upload"
                          StartIcon="@Icons.Material.Filled.CameraAlt">
                    Upload Prescription
                </MudButton>
            </MudPaper>
        }
    

@code {
    private bool isLoading = true;
    private List<MedicationDto> medications = new();
    
    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        
        if (!AuthService.IsAuthenticated())
        {
            Navigation.NavigateTo("/login");
            return;
        }
        
        await LoadMedications();
    }
    
    private async Task LoadMedications()
    {
        isLoading = true;
        try
        {
            medications = await MedicationService.GetAllAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading medications: {ex.Message}", Severity.Error);
        }
        finally
        {
            isLoading = false;
        }
    }
}

