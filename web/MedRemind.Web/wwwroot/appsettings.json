{
  "ApiSettings": {
    "BaseUrl": "http://localhost:5000",
    "Timeout": 120,
    "EnableRetry": true,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 2,
    "EnableLogging": true
  },
  "Endpoints": {
    "Auth": {
      "Register": "/api/users/register",
      "Login": "/api/auth/login",
      "VerifyOtp": "/api/auth/verify-otp",
      "ResendOtp": "/api/auth/resend-otp",
      "CurrentUser": "/api/users/me"
    },
    "Prescriptions": {
      "Upload": "/api/prescriptions/upload-base64",
      "List": "/api/prescriptions",
      "Details": "/api/prescriptions/{id}",
      "Image": "/api/prescriptions/{id}/image",
      "Reprocess": "/api/prescriptions/{id}/reprocess",
      "Delete": "/api/prescriptions/{id}",
      "Statistics": "/api/prescriptions/statistics"
    },
    "Medications": {
      "List": "/api/medications",
      "Details": "/api/medications/{id}",
      "Search": "/api/medications/search",
      "Update": "/api/medications/{id}",
      "Delete": "/api/medications/{id}",
      "ByPrescription": "/api/medications/prescription/{id}"
    },
    "Validation": {
      "GetWorkflow": "/api/validation/workflow/{id}",
      "ConfirmMedication": "/api/validation/medication/{id}/confirm",
      "CorrectMedication": "/api/validation/medication/{id}/correct",
      "DeleteMedication": "/api/validation/medication/{id}",
      "CompleteWorkflow": "/api/validation/workflow/{id}/complete",
      "Progress": "/api/validation/workflow/{id}/progress"
    },
    "VoiceRecordings": {
      "List": "/api/voice-recordings",
      "Upload": "/api/voice-recordings/upload-base64",
      "Details": "/api/voice-recordings/{id}",
      "Play": "/api/voice-recordings/{id}/play",
      "PlaybackUrl": "/api/voice-recordings/{id}/playback-url",
      "Update": "/api/voice-recordings/{id}",
      "Delete": "/api/voice-recordings/{id}"
    },
    "Reminders": {
      "List": "/api/reminders",
      "Create": "/api/reminders",
      "CreateBulk": "/api/reminders/bulk",
      "Details": "/api/reminders/{id}",
      "Update": "/api/reminders/{id}",
      "Toggle": "/api/reminders/{id}/toggle",
      "Delete": "/api/reminders/{id}",
      "CalculateTimes": "/api/reminders/calculate-times",
      "Upcoming": "/api/reminders/upcoming",
      "ByMedication": "/api/reminders/medication/{id}"
    },
    "Users": {
      "Profile": "/api/users/{id}",
      "UpdateProfile": "/api/users/{id}",
      "DeleteAccount": "/api/users/{id}",
      "CheckExists": "/api/users/exists/{phoneNumber}"
    }
  },
  "AppSettings": {
    "AppName": "MedRemind",
    "Version": "1.0.0",
    "Environment": "Development"
  },
  "Features": {
    "EnableNotifications": true,
    "EnableVoiceRecordings": true,
    "EnableDarkMode": true,
    "EnableOfflineMode": false,
    "EnableAnalytics": false
  },
  "Authentication": {
    "OtpLength": 6,
    "OtpExpiryMinutes": 5,
    "TokenExpiryDays": 7,
    "RequireEmailVerification": true
  },
  "Storage": {
    "LocalStorageKey": "medremind_auth",
    "CacheDurationMinutes": 30,
    "MaxCacheSizeMB": 50
  },
  "UI": {
    "DefaultTheme": "light",
    "EnableAnimations": true,
    "ItemsPerPage": 10,
    "MaxFileUploadSizeMB": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

